# Copia este archivo a SmartDrop/.env y completa los valores reales.
# No subas el archivo .env a GitHub.

# Django
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-cadena-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase (backend Django)
# URL del proyecto: Dashboard → Project Settings → API
SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave secreta de servidor (secret / service_role). Nunca la uses en una app móvil ni en código público.
SUPABASE_KEY=tu-clave-secreta-de-supabase
