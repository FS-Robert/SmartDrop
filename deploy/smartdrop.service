[Unit]
Description=SmartDrop (Django + Channels con Daphne)
After=network-online.target
Wants=network-online.target

[Service]
User=__USUARIO__
Group=__USUARIO__
WorkingDirectory=__REPO_DIR__/SmartDrop
Environment=PYTHONUNBUFFERED=1
# Un solo proceso a propósito: el canal de WebSockets en memoria, la caché local y el
# monitor de fugas viven dentro de él. Solo escucha en localhost; Nginx da la cara a Internet.
ExecStart=__REPO_DIR__/.venv/bin/daphne -b 127.0.0.1 -p 8000 --proxy-headers SmartDrop.asgi:application
Restart=always
RestartSec=3

# Endurecimiento: si alguien lograra ejecutar código dentro de la app, no podría usar sudo (NoNewPrivileges),
# ni tocar el sistema, ni modificar el código o el entorno de Python para quedarse. La app solo escribe en
# SmartDrop/ (bases SQLite), media/ y ml_models/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadOnlyPaths=__REPO_DIR__/.venv __REPO_DIR__/SmartDrop/App __REPO_DIR__/SmartDrop/ml_engine __REPO_DIR__/SmartDrop/SmartDrop

[Install]
WantedBy=multi-user.target
