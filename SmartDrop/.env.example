# Copia este archivo a SmartDrop/.env y completa los valores. No subas .env al repositorio.

DJANGO_SECRET_KEY=<CLAVE_DJANGO_NUEVA>
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Opcional: por defecto se confía en https://<cada host de ALLOWED_HOSTS>.
CSRF_TRUSTED_ORIGINS=

SUPABASE_URL=https://<PROYECTO>.supabase.co
SUPABASE_KEY=<CLAVE_PRIVADA_DEL_SERVIDOR>

MQTT_BROKER_HOST=<HOST_DEL_BROKER>
MQTT_BROKER_PORT=8883
MQTT_USERNAME=<USUARIO_MQTT>
MQTT_PASSWORD=<PASSWORD_MQTT>
MQTT_CA_CERT=

# Clave que el ESP32 manda en la cabecera X-Api-Key al enviar lecturas a /api/lecturas/.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
LECTURAS_API_KEY=
# Clave para firmar los tokens de la app (opcional en desarrollo; deploy/actualizar.sh la genera en el servidor).
JWT_SIGNING_KEY=

# Vacío en desarrollo. Obligatorio en producción con varios workers.
REDIS_URL=

# ── Motor de predicción (opcional) ──
# Monitor automático de fugas: 1 = activo, 0 = apagado.
ML_MONITOR_ENABLED=1
ML_MONITOR_INTERVAL_MINUTES=10
ML_LEAK_ALERT_THRESHOLD=0.6
ML_LEAK_ALERT_COOLDOWN_HOURS=12
# Carpeta de los modelos entrenados (por defecto SmartDrop/ml_models).
ML_MODELS_DIR=
# Base de series temporales en Postgres (vacío = SQLite local ml_timeseries.sqlite3).
ML_TIMESERIES_DB_HOST=
ML_TIMESERIES_DB_PORT=5432
ML_TIMESERIES_DB_NAME=postgres
ML_TIMESERIES_DB_USER=postgres
ML_TIMESERIES_DB_PASSWORD=

# ── Seguridad ──
# Token que el ESP32 / simulador envía en la cabecera X-Device-Token a /api/lecturas/.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vacío = se aceptan lecturas sin token (solo mientras se actualiza el firmware).
DEVICE_API_TOKEN=
# Rate limiting: 1 = activo (siempre en el servidor). Ajustes opcionales: login_ip=40/m,registro=50/h
RATELIMIT_ENABLED=1
RATELIMIT_OVERRIDES=
# Revisión del temporizador de la válvula (segundos).
VALVE_WATCHDOG_SECONDS=30

# ── Gotita, la asistente (Claude) ──
# Llave de Anthropic: SOLO en el .env del servidor, nunca en la web, la app ni Git.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# 1 = Gotita activa, 0 = apagada para todos (la app y la web siguen funcionando igual).
ASISTENTE_ACTIVO=1
# Preguntas por usuario al día (evita que alguien gaste la cuenta).
ASISTENTE_LIMITE_DIARIO=150

# Voz natural de Gotita (ElevenLabs). Vacío = usa la voz del navegador o del teléfono.
ELEVENLABS_API_KEY=
# Voz elegida (ID de la biblioteca de voces de ElevenLabs). Vacío = "Sarah", suave y clara.
ELEVENLABS_VOICE_ID=
# Modelo rápido que habla español e inglés.
ELEVENLABS_MODEL=eleven_flash_v2_5
# Frases con voz natural por usuario al día (cuida el saldo de ElevenLabs).
ASISTENTE_VOZ_POR_DIA=400
# Dictado con ElevenLabs (entiende español e inglés sin cambiar nada). La llave necesita el permiso
# "Speech to Text"; si no lo tiene, Gotita usa el dictado del navegador.
ELEVENLABS_STT_MODEL=scribe_v2
# Preguntas dictadas por usuario al día.
ASISTENTE_DICTADO_POR_DIA=300
